{
	"name": "float-note",
	"version": "0.7.2",
	"description": "Always-on-top note overlay for Obsidian on macOS",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
